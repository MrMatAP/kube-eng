/* Colours come from the registered "kube-eng" theme (main.py), sourced
   from var/mrmat.css's dark palette -- $primary/$secondary/$accent/
   $background/$surface/$panel/$success/$warning/$error/$text-muted are
   Textual's own theme tokens, not locally-defined variables, so a redeploy
   of the theme's colours needs no changes here. */

KubeEngApp {

    AppHeader {
        background: $secondary;
        color: white;
        padding: 0 2;
        height: 1;

        #app-title-left {
            color: white;
            width: 1fr;
            content-align: left middle;
        }

        #app-title-right {
            color: white;
            width: auto;
            content-align: right middle;
        }
    }

    AppBody {
        padding: 1;

        #tabs {
            height: 100%;
        }
    }

    /* Ansible Tab Styling */
    .ansible-tab {
        padding: 1;

        #ansible-title {
            height: 3;
            content-align: center middle;
            text-style: bold;
            color: white;
            margin-bottom: 1;
        }

        #ansible-title.ansible-title--running {
            background: $primary;
        }

        #ansible-title.ansible-title--success {
            background: $success;
        }

        #ansible-title.ansible-title--failure {
            background: $error;
        }

        #ansible-log {
            height: 1fr;
        }

        #ansible-cancel-button {
            dock: bottom;
            width: 100%;
            margin-top: 1;
        }
    }

    /* Status Tab Styling */
    .status-tab {
        padding: 2;
        align: center middle;

        .status-placeholder {
            text-align: center;
            color: $text-muted;
            padding: 2;
            border: round $primary;
            background: $surface;
        }
    }

    .bordered {
        border: round $primary;
    }

    ConfigSidebar {
        width: 20;
        height: 100%;
        border-right: solid $primary;
        background: $surface;

        #sidebar-nav {
            width: 100%;
            height: 100%;
            background: $surface;
        }

        OptionList {
            background: $surface;
            border: none;
        }

        OptionList > .option-list--option {
            padding: 0 1;
        }

        OptionList > .option-list--option-highlighted {
            background: $primary;
        }
    }

    #config-scroll {
        width: 1fr;
        height: 100%;
    }

    .form {
        layout: vertical;

        .section-header {
            background: $primary-darken-2;
            color: white;
            text-style: bold;
            padding: 0 1;
            margin: 1 0;
            width: 100%;
        }

        .form-group {
            layout: vertical;
            border: round $primary;
            background: $background;
            margin: 0 0 1 0;
            padding: 1;

            .form-group {
                border: round $accent;
                margin: 1 0;
                padding: 1;
            }
        }

        .form-line {
            layout: horizontal;
            margin: 0 0 1 0;
            padding: 0 1;
            align: left middle;

            Label {
                width: 1fr;
                align: right middle;
                padding: 0 1 0 0;
            }

            Input {
                width: 5fr;
            }

            Checkbox {
                width: 1fr;
            }
        }

        .form-actions {
            layout: horizontal;
            margin: 1 0 0 0;
            padding: 1;
            align: right middle;
            border-top: solid $accent;
        }

    }

    Collapsible {
        margin: 0 0 1 0;
        padding: 0;
    }

    Screen {
        background: $background;
    }

    Footer {
        padding-left: 2
    }

}
